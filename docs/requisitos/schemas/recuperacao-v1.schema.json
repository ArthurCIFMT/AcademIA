        "required": [
          "fragmento_id",
          "ingestao_id",
          "documento_versao_id",
          "aprovacao_revisao",
          "titulo",
          "origem_url",
          "idioma",
          "pagina",
          "linha_inicio",
          "linha_fim",
          "secao",
          "texto",
          "texto_hash",
          "score"
        ],
        "title": "Evidence",
        "type": "object"
      }

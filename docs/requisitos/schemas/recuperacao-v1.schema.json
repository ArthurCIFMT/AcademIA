      "estado": {
        "enum": [
          "EVIDENCIAS_ENCONTRADAS",
          "SEM_EVIDENCIAS",
          "EVIDENCIA_INSUFICIENTE",
          "CONFLITO",
          "SERVICO_INDISPONIVEL"

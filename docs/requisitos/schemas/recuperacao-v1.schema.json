          },
          "linha_fim": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Linha Fim"
          },
          "secao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secao"
          },
          "texto": {
            "title": "Texto",
            "type": "string"
          },
          "texto_hash": {
            "title": "Texto Hash",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }

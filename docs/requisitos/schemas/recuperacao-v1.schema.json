        "title": "Suporte Saude",
        "type": "string"
      },
      "motivo": {
        "title": "Motivo",
        "type": "string"
      },
      "busca_ms": {
        "default": 0,
        "title": "Busca Ms",
        "type": "number"
      },
      "total_ms": {
        "default": 0,
        "title": "Total Ms",
        "type": "number"
      }
    },
    "required": [
      "estado",
      "evidencias",
      "suporte_saude",
      "motivo"

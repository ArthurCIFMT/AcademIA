          "condicao": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Condicao",
            "type": "string"
          },
          "populacao": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Populacao",
            "type": "string"
          },
          "intervencao": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Intervencao",
            "type": "string"
          }
        },
        "required": [
          "condicao",
          "populacao",
          "intervencao"
        ],
        "title": "Scope",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "contexto_id": {
        "format": "uuid",
        "title": "Contexto Id",
        "type": "string"
      },
      "finalidade": {
        "enum": [
          "DUVIDAS",
          "GERACAO_GERAL",
          "TRIAGEM",
          "DUVIDAS_SAUDE_GERAL"
        ],
        "title": "Finalidade",
        "type": "string"
      },
      "consulta": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Consulta",
        "type": "string"
      },
      "top_k": {
        "default": 5,
        "maximum": 8,
        "minimum": 1,
        "title": "Top K",
        "type": "integer"
      },
      "escopo_saude": {
        "anyOf": [
          {
            "$ref": "#/$defs/Scope"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "contexto_id",
      "finalidade",
      "consulta"

            ],
            "title": "Cadencia"
          },
          "intervalo_segundos": {
            "maximum": 600,
            "minimum": 0,
            "title": "Intervalo Segundos",
            "type": "integer"
          },
          "observacoes": {
            "maxLength": 1000,
            "title": "Observacoes",
            "type": "string"
          }

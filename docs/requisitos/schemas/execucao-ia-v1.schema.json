          "possui_condicoes_saude",
          "condicoes_saude",
          "usa_medicamentos",
          "medicamentos",
          "possui_dor_lesao_limitacao",
          "limitacoes",
          "restricao_exercicio_declarada",
          "evento_saude_importante_recente",
          "observacoes"

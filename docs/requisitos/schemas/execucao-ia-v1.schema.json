        "required": [
          "exercicio_id",
          "ordem",
          "equipamento_ids",
          "series",
          "repeticoes",
          "carga_kg",
          "cadencia",
          "intervalo_segundos",
          "observacoes"
        ],
        "title": "PlanItem",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "idioma": {
        "const": "pt-BR",
        "title": "Idioma",
        "type": "string"
      },
      "dias": {
        "items": {

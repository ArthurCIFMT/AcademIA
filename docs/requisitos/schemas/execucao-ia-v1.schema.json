      "OnboardingData": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "condicoes_saude": {
                  "maxItems": 0
                }
              }
            },
            "if": {
              "properties": {
                "possui_condicoes_saude": {
                  "const": "SIM"
                }
              },
              "required": [
                "possui_condicoes_saude"
              ]
            },
            "then": {
              "properties": {
                "condicoes_saude": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "else": {
              "properties": {
                "medicamentos": {
                  "maxItems": 0
                }
              }
            },
            "if": {
              "properties": {
                "usa_medicamentos": {

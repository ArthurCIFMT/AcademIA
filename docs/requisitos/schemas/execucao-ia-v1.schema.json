            "pattern": "^[1-9][0-9]{0,2}(?:-[1-9][0-9]{0,2})?$",
            "title": "Repeticoes",
            "type": "string"
          },
          "carga_kg": {
            "anyOf": [
              {
                "maximum": 999999.99,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carga Kg"
          },
          "cadencia": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"

        "maxItems": 6,
        "title": "Historico",
        "type": "array"
      },
      "versao_base_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Versao Base Id"
      }
    },
    "required": [
      "solicitacao_id",
      "finalidade"
